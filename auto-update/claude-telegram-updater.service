[Unit]
Description=Claude Telegram Bot Auto-Updater (GitHub webhook)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
Restart=on-failure
RestartSec=10
ExecStart=/usr/bin/node /opt/claude-telegram/auto-update/webhook.js
EnvironmentFile=-/opt/claude-telegram/auto-update/.env

[Install]
WantedBy=multi-user.target
